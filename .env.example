# API Configuration (Laravel backend)
# Ensure Laravel config/cors.php allows your frontend origin (FRONTEND_URL)
# NEXT_PUBLIC_API_BASE_URL=http://magicshow.pl-sites.com/api/v1

# Backend origin for images - MUST match protocol (https) if frontend uses HTTPS
# Prevents mixed content: page on https loading images from http
# NEXT_PUBLIC_BACKEND_ORIGIN=https://magicshow.pl-sites.com

# Site Configuration (Frontend URL - for sitemap, robots, etc.)
# NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# Cache (optional) - seconds until frontend revalidates API data
# NEXT_PUBLIC_CACHE_REVALIDATE=60

# Set to false to disable frontend cache (fetch fresh from API every request)
# NEXT_PUBLIC_CACHE_ENABLED=false

# On-demand revalidation - secret for Backend to trigger cache invalidation (must match Backend NEXTJS_REVALIDATION_SECRET)
# REVALIDATION_SECRET=your-secret-key

# ===== Sentry (optional) - Error tracking =====
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=

# ===== Google Analytics (optional) =====
# NEXT_PUBLIC_GA_MEASUREMENT_ID=